{
  "name": "codeforge-arena",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "preview": "npm run preview --workspace=client",
    "test": "npm test --workspace=client",
    "gen:problems": "npm run gen:problems --workspace=client",
    "deploy": "node scripts/deploy-vercel.mjs",
    "deploy:preview": "node scripts/deploy-vercel.mjs --preview",

    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "install:all": "npm install",
    "test:server": "npm test --workspace=server",
    "test:integration": "npm run test:integration --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
