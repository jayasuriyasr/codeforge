# ─────────────────────────────────────────────────────────────────────────────
# CodeForge Arena — server environment
# Copy to `.env` and fill in. Every key here is read by src/config.js; nothing
# else in the code touches process.env directly.
# ─────────────────────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development

# ── HTTP ────────────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated list of allowed browser origins (CORS).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# ── MongoDB ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/codeforge

# ── Redis ──────────────────────────────────────────────────────────────────
# NOTE: docker-compose maps Redis to host port 6380 (not 6379) to avoid
# clashing with a local Redis. Match this to your setup.
REDIS_URL=redis://localhost:6380

# ── JWT ────────────────────────────────────────────────────────────────────
# MUST be a long random string in production (>= 32 chars). Generate with:
#   openssl rand -hex 32
# A missing/weak secret is a warning in development and a HARD FAILURE in prod.
JWT_SECRET=change_me_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# ── Judge sandbox ──────────────────────────────────────────────────────────
# Prefer a digest pin so the judge environment cannot drift between runs:
#   docker inspect --format='{{index .RepoDigests 0}}' codeforge/fat-judge
FAT_JUDGE_IMAGE=codeforge/fat-judge:latest
# One ephemeral container per submission. Warm buffer hides docker-run latency;
# each warm container is still used exactly once. Throughput = workers x concurrency.
JUDGE_CONCURRENCY=4
JUDGE_WARM_SANDBOXES=4
# Container memory ceiling (host protection). The problem's real limit is
# enforced by measurement in the supervisor, so this only needs to fit the
# biggest compiler + supervisor overhead.
JUDGE_SANDBOX_MEMORY_MB=512
JUDGE_WORKSPACE_TMPFS_MB=256
JUDGE_PIDS_LIMIT=64
JUDGE_COMPILE_TIMEOUT_MS=10000
JUDGE_MAX_CASES_PER_RUN=200

# ── SSE ────────────────────────────────────────────────────────────────────
SSE_TIMEOUT_MS=60000
